# Configuracion de entorno opcional para Lector Manga
PORT=3000
NODE_ENV=production

# Base de datos para persistencia de usuarios en Vercel (PostgreSQL / Neon / Supabase)
# Si se deja vacio en desarrollo local, los datos se guardan automaticamente en .local-data/
DATABASE_URL=postgresql://usuario:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clave secreta para firmar sesiones de usuario (minimo 32 caracteres)
SESSION_SECRET=super_secret_session_key_replace_with_random_string_32_chars
